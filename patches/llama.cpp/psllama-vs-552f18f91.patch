+        int device, size_t * budget, size_t * usage, size_t * heap_size) {
+    GGML_ASSERT(device >= 0 && device < (int) vk_instance.device_indices.size());
+    GGML_ASSERT(device < (int) vk_instance.device_supports_membudget.size());
