<?xml version="1.0" encoding="utf-8"?>
<!-- Fetch arm, a table, three coloured blocks and a plate, seen by one camera
     facing the robot. Installed next to gymnasium-robotics' fetch assets so
     its includes resolve (blocks_env.py copies it there). -->
<mujoco>
	<compiler angle="radian" coordinate="local" meshdir="../stls/fetch" texturedir="../textures"></compiler>
	<option timestep="0.002">
		<flag warmstart="enable"></flag>
	</option>

	<include file="shared.xml"></include>

	<worldbody>
		<geom name="floor0" pos="0.8 0.75 0" size="0.85 0.7 1" type="plane" condim="3" material="floor_mat"></geom>
		<body name="floor0" pos="0.8 0.75 0">
			<site name="target0" pos="0 0 0.5" size="0.001 0.001 0.001" rgba="0 0 0 0" type="sphere"></site>
		</body>

		<include file="robot.xml"></include>

		<body pos="1.3 0.75 0.2" name="table0">
			<geom size="0.25 0.35 0.2" type="box" mass="2000" material="table_mat"></geom>
			<geom name="pad_left" pos="-0.08 -0.18 0.2005" size="0.045 0.045 0.0005" type="box" rgba="0.55 0.55 0.6 1" contype="0" conaffinity="0"></geom>
			<geom name="pad_middle" pos="-0.08 0 0.2005" size="0.045 0.045 0.0005" type="box" rgba="0.55 0.55 0.6 1" contype="0" conaffinity="0"></geom>
			<geom name="pad_right" pos="-0.08 0.18 0.2005" size="0.045 0.045 0.0005" type="box" rgba="0.55 0.55 0.6 1" contype="0" conaffinity="0"></geom>
			<geom name="plate" pos="0.14 0 0.202" size="0.075 0.002" type="cylinder" rgba="0.97 0.82 0.1 1" contype="0" conaffinity="0"></geom>
		</body>

		<body name="object0" pos="1.22 0.57 0.425">
			<joint name="object0:joint" type="free" damping="0.01"></joint>
			<geom size="0.025 0.025 0.025" type="box" condim="3" name="object0" rgba="0.85 0.1 0.1 1" mass="2"></geom>
			<site name="object0" pos="0 0 0" size="0.002 0.002 0.002" rgba="0 0 0 0" type="sphere"></site>
		</body>
		<body name="object1" pos="1.22 0.75 0.425">
			<joint name="object1:joint" type="free" damping="0.01"></joint>
			<geom size="0.025 0.025 0.025" type="box" condim="3" name="object1" rgba="0.1 0.65 0.2 1" mass="2"></geom>
		</body>
		<body name="object2" pos="1.22 0.93 0.425">
			<joint name="object2:joint" type="free" damping="0.01"></joint>
			<geom size="0.025 0.025 0.025" type="box" condim="3" name="object2" rgba="0.1 0.3 0.9 1" mass="2"></geom>
		</body>

		<camera name="front" pos="1.9 0.75 1.3" xyaxes="0 1 0 -0.787 0 0.617" fovy="44"></camera>
		<light directional="true" ambient="0.3 0.3 0.3" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="false" pos="0 0 4" dir="0 0 -1" name="light0"></light>
	</worldbody>

	<actuator>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:l_gripper_finger_joint" kp="30000" name="robot0:l_gripper_finger_joint" user="1"></position>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:r_gripper_finger_joint" kp="30000" name="robot0:r_gripper_finger_joint" user="1"></position>
	</actuator>
</mujoco>
